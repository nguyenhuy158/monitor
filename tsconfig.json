{
  "extends": "@huyab/config/tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["@cloudflare/workers-types", "vite/client", "node"],
    "allowImportingTsExtensions": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./frontend/src/*"],
      "@ui": ["./frontend/src/ui"],
      "@ui/*": ["./frontend/src/ui/*"]
    }
  },
  "include": ["frontend/src", "backend/src", "shared", "vite.config.ts"]
}

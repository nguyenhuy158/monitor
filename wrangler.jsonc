{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "monitor",
  "main": "server/src/index.ts",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "vars": {
    "SSO_ISSUER": "https://auth.huyab.click",
    "ODOO_URL": "",
    "ODOO_DB": "",
    "ODOO_USER": "",
    "ODOO_PASSWORD": "",
    "ALERT_EMAIL": "ntqhuy2k2@gmail.com"
  },
  "services": [{ "binding": "MAILER", "service": "mailer" }],
  "routes": [{ "pattern": "moni.huyab.click", "custom_domain": true }]
}

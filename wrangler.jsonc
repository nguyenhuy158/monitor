{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "monitor",
  "main": "src/worker/index.ts",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./src/web/dist",
    "binding": "ASSETS"
  },
  "vars": {
    "SSO_ISSUER": "https://auth.huyab.click",
    "ODOO_URL": "",
    "ODOO_DB": "",
    "ODOO_USER": "",
    "ODOO_PASSWORD": "",
    "ALERT_EMAIL": "ntqhuy2k2@gmail.com"
  },
  "workers_dev": false,
  "routes": [{ "pattern": "moni.huyab.click", "custom_domain": true }],
  "services": [
    {
      "binding": "MAILER",
      "service": "mailer"
    }
  ]
}

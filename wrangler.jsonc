{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "monitor",
  "main": "server/src/index.ts",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "vars": {
    "SSO_ISSUER": "https://auth.huyab.click",
    "ODOO_URL": "",
    "ODOO_DB": "",
    "ODOO_USER": "",
    "ODOO_PASSWORD": "",
    "ALERT_EMAIL": "ntqhuy2k2@gmail.com"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "db",
      "database_id": "6eb9cfce-f6f3-4476-8e46-7c8e954d93c1"
    }
  ],
  "services": [{ "binding": "MAILER", "service": "mailer" }],
  "routes": [{ "pattern": "moni.huyab.click", "custom_domain": true }]
}

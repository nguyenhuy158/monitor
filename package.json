{
  "name": "monitor",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/build-info.mjs && wrangler dev",
    "dev:client": "node scripts/build-info.mjs && vite",
    "build": "node scripts/build-info.mjs && vite build",
    "check": "node scripts/build-info.mjs && tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "e2e": "node e2e/run.mjs",
    "e2e:prod": "E2E_BASE_URL=https://alert.huyab.click node e2e/ui-smoke.mjs",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@dicebear/collection": "^9.4.2",
    "@dicebear/core": "^9.4.3",
    "@huyab/sso": "github:nguyenhuy158/kit#v0.1.0&path:packages/sso",
    "date-fns": "^4.4.0",
    "hono": "^4.6.14",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@cloudflare/workers-types": "^4.20241230.0",
    "@huyab/config": "github:nguyenhuy158/kit#v0.1.0&path:packages/config",
    "@huyab/e2e": "github:nguyenhuy158/kit#v0.1.0&path:packages/e2e",
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright-core": "^1.63.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "wrangler": "^4.100.0"
  }
}
